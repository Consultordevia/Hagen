    procedure graba()
    var
        RecCV: Record "Sales Shipment Header";
        RecCV2: Record "Sales Shipment Header";
        v: Dialog;

    begin

        v.Open('#1##########################');


        v.Update(1, nexpe);
        RecCV2.RESET;
        RecCV2.SETCURRENTKEY("Posting Date");
        RecCV2.SetRange("Posting Date", 20250601D, 20250807D);
        IF RecCV2.FINDSET THEN
            repeat
                if CopyStr(RecCV2."Nº expedición", 1, 7) = nexpe then begin
                    RecCV2.Preparador := codprepa;
                    RecCV2.MODIFY;
                end;
            until RecCV2.Next = 0;

        v.Close();


    end;


